# Docker runtime configuration. Copy to `.env.docker` and fill in every value
# marked `change-me`. This file holds secrets: never commit `.env.docker`.
#
#   cp .env.docker.example .env.docker

# --- Laravel ---------------------------------------------------------------
APP_NAME=Jahez
APP_ENV=production
APP_DEBUG=false
# Generate once and paste:  docker run --rm jahez-api php artisan key:generate --show
# (or: php artisan key:generate --show from jahez_api/ with the same code).
APP_KEY=change-me-paste-base64-key-here
# Public URLs (HTTPS in production; the go-live gate in jahez_api/docs/deployment.md
# refuses plain http for APP_URL / FRONTEND_URL).
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# --- Database (MySQL service in docker-compose.yml) -------------------------
DB_DATABASE=jahez
DB_USERNAME=jahez
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Platform behavior (sane production defaults; see jahez_api/.env.example)
SESSION_DRIVER=array
QUEUE_CONNECTION=database
CACHE_STORE=database
SANCTUM_EXPIRATION=480

# --- Mail (reset + invitation links carry real tokens: never `log`/`array`) --
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=change-me-mail-host
MAIL_PORT=587
MAIL_USERNAME=change-me-mail-user
MAIL_PASSWORD=change-me-mail-password
MAIL_FROM_ADDRESS=noreply@example.com

# --- Frontend build ----------------------------------------------------------
# Baked into the frontend image at build time; must be the public API address.
FRONT_API_URL=https://api.example.com/api/v1
