# Docker runtime configuration. Copy to `.env.docker` and fill in every value
# marked `change-me`. This file holds secrets: never commit `.env.docker`.
#
#   cp .env.docker.example .env.docker
#
# Local Docker:  docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.local.yml up -d --build
# Coolify:       paste these same values into the resource's Environment Variables
#                (every ${VAR} in docker-compose.yml appears there automatically).

# --- Laravel ---------------------------------------------------------------
APP_NAME=Jahez
APP_ENV=production
APP_DEBUG=false
# Generate once and paste:  php artisan key:generate --show   (from jahez_api/)
# (or: docker run --rm <api-image> php artisan key:generate --show).
# Never reuse a development key. The go-live gate fails until this is a real
# base64: key (this placeholder included).
APP_KEY=change-me-paste-base64-key-here
# Public URLs (HTTPS in production; the go-live gate in jahez_api/docs/deployment.md
# refuses plain http for APP_URL / FRONTEND_URL).
# On Coolify these are the two domains you configure on the `api` and
# `frontend` services (internal port 80 for both).
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
# stderr: logs go to the container log (docker logs / Coolify) instead of a file
# in the shared storage volume.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (MySQL service in docker-compose.yml) -------------------------
DB_CONNECTION=mysql
DB_DATABASE=jahez
DB_USERNAME=jahez
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Proxy & CORS (required behind Coolify) ----------------------------------
# Exact browser origin(s) allowed to call the API, comma-separated, no wildcard.
# Must be the frontend domain, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
# The stack publishes no host ports: the only traffic reaching the containers
# comes through the Coolify proxy, so trusting it is safe. The go-live gate
# reports a WARN (not FAIL) for `*`; restricting it to the proxy CIDR removes
# the warning if your host provides a stable range.
TRUSTED_PROXIES=*

# --- Platform behavior (sane production defaults; see jahez_api/.env.example)
SESSION_DRIVER=array
QUEUE_CONNECTION=database
CACHE_STORE=database
SANCTUM_EXPIRATION=480
BCRYPT_ROUNDS=12
JAHEZ_BUSINESS_TIMEZONE=Africa/Cairo

# --- Business policies (optional) ---------------------------------------------
# docker-compose.yml passes these with the application's own defaults (shown here).
# Change one only after the owner decides it; jahez_api/docs/deployment.md §2 lists
# what each one does and which open question decides it. Empty means "not decided".
# JAHEZ_FACTORY_APPROVAL_REQUIRED=true
# JAHEZ_FACTORY_LEGAL_CHANGES_REVIEWED=true
# JAHEZ_FACTORY_REQUIRED_FIELDS=sectors
# JAHEZ_PROVIDER_REQUIRED_FIELDS=
# JAHEZ_DIRECTORY_SHOWS_CONTACT_DETAILS=false
# JAHEZ_PROVIDER_EVALUATION_SCALE_MAX=
# JAHEZ_PROVIDER_EVALUATION_PASS_MARK=
# JAHEZ_MARKETPLACE_SINGLE_AWARD=true
# JAHEZ_AGREEMENTS_IMC_APPROVAL_REQUIRED=true
# JAHEZ_NOTIFICATION_EMAILS=true
# JAHEZ_PAYMENT_GATEWAY=
# JAHEZ_DOCUMENTS_DISK=local
# JAHEZ_LOGO_MAX_KB=2048
# JAHEZ_LEGAL_DOCUMENT_MAX_KB=5120
# JAHEZ_ANNOUNCEMENT_VIDEO_MAX_KB=20480
# JAHEZ_REGISTRATIONS_PER_HOUR=10

# --- Mail (reset + invitation links carry real tokens: never `log`/`array`) --
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=change-me-mail-host
MAIL_PORT=587
MAIL_USERNAME=change-me-mail-user
MAIL_PASSWORD=change-me-mail-password
MAIL_FROM_ADDRESS=noreply@example.com

# --- Frontend build ----------------------------------------------------------
# Baked into the frontend image at build time; must be the public API address.
# Required: the build stops without it (there is no localhost fallback). The same
# origin is written into the frontend's Content-Security-Policy. On Coolify set it as
# a build-time variable too, and redeploy (rebuild) after changing it.
# Local Docker (docker-compose.local.yml): http://localhost:8000/api/v1
FRONT_API_URL=https://api.example.com/api/v1
